// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/dts-v1/;
/ {
 description = "MOHISM RV1106G3 Linux";
 #address-cells = <1>;
 images {
  kernel {
   description = "Linux 5.10.160 zImage";
   data = /incbin/("zImage");
   type = "kernel";arch = "arm";os = "linux";compression = "none";
   load = <0x02008000>;entry = <0x02008000>;
   hash {algo = "sha256";};
  };
  fdt {
   description = "RV1106G3-VINS EDA board";
   data = /incbin/("rv1106g3-mohism-vins.dtb");
   type = "flat_dt";arch = "arm";compression = "none";
   load = <0x03000000>;
   hash {algo = "sha256";};
  };
 };
 configurations {
  default = "conf";
  conf {description = "MOHISM";kernel = "kernel";fdt = "fdt";};
 };
};
