# Full PREEMPT_RT, not just voluntary or desktop preemption.
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_VOLUNTARY is not set
# CONFIG_PREEMPT is not set
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HZ_1000=y
# CONFIG_HZ_100 is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_PREEMPT=y
# The board uses the normal UART and USB consoles; FIQ debugger is disabled in DTS.
# CONFIG_FIQ_DEBUGGER is not set
# CONFIG_ROCKCHIP_FIQ_DEBUGGER is not set
# Superseded by PREEMPT_RT softirq handling.
# CONFIG_RT_SOFTINT_OPTIMIZATION is not set
# Rebuild all modules for this kernel; do not reuse non-RT vendor binaries.
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set
