BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_MOHISM_PATH)/../../scripts/post-build.sh"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_MOHISM_PATH)/../../board/mohism/busybox.config"
BR2_PACKAGE_MOHISM_VINS=y
BR2_PACKAGE_LIBV4L=y
BR2_PACKAGE_LIBV4L_UTILS=y
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_HOST_KMOD=y
BR2_PACKAGE_RT_TESTS=y
BR2_PACKAGE_OPENCV4_LIB_CALIB3D=y
BR2_PACKAGE_OPENCV4_LIB_IMGPROC=y
BR2_PACKAGE_OPENCV4_LIB_IMGCODECS=y
BR2_PACKAGE_OPENCV4_LIB_VIDEO=y
