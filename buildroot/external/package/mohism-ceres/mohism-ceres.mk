MOHISM_CERES_VERSION = 2.1.0
MOHISM_CERES_SOURCE = ceres-solver-$(MOHISM_CERES_VERSION).tar.gz
MOHISM_CERES_SITE = $(call github,ceres-solver,ceres-solver,$(MOHISM_CERES_VERSION))
MOHISM_CERES_LICENSE = BSD-3-Clause
MOHISM_CERES_LICENSE_FILES = LICENSE
MOHISM_CERES_INSTALL_STAGING = YES
MOHISM_CERES_DEPENDENCIES = eigen
MOHISM_CERES_CONF_OPTS = -DBUILD_TESTING=OFF -DBUILD_EXAMPLES=OFF -DBUILD_BENCHMARKS=OFF \
 -DBUILD_SHARED_LIBS=ON -DMINIGLOG=ON -DGFLAGS=OFF -DSUITESPARSE=OFF -DCXSPARSE=OFF \
 -DLAPACK=OFF -DEIGENSPARSE=ON -DSCHUR_SPECIALIZATIONS=OFF -DCMAKE_CXX_FLAGS="$(TARGET_CXXFLAGS) -O2 -fno-fast-math"
# Eigen-heavy solver files otherwise exhaust memory on small build hosts.
MOHISM_CERES_MAKE = $(MAKE1)
$(eval $(cmake-package))
